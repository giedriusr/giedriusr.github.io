#!/usr/bin/env bash
# Assemble the deployable site into _site/ (everything except repo tooling).
set -euo pipefail
cd "$(dirname "$0")/.."
rm -rf _site && mkdir -p _site
for entry in * .nojekyll; do
  case "$entry" in
    _site|node_modules|bin|test-results|README.md|'*') continue ;;
  esac
  cp -R "$entry" _site/
done
echo "Built _site/ ($(find _site -type f | wc -l) files)"
